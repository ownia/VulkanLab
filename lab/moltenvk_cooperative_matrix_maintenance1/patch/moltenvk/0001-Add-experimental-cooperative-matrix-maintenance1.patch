From 31d353ae11dbb84f86a4da60bea0034bde093088 Mon Sep 17 00:00:00 2001
From: Weizhao Ouyang <o451686892@gmail.com>
Date: Wed, 14 Oct 2026 14:16:14 +0800
Subject: [PATCH] Add experimental cooperative matrix maintenance1

Layer opt-in maintenance1 feature and query plumbing on the original KHR
cooperative matrix patches.

Signed-off-by: Weizhao Ouyang <o451686892@gmail.com>
---
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.h      |  1 +
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm     | 29 +++++++++++++++++++
 .../GPUObjects/MVKDeviceFeatureStructs.def    |  1 +
 MoltenVK/MoltenVK/GPUObjects/MVKInstance.mm   |  1 +
 MoltenVK/MoltenVK/Layers/MVKExtensions.def    |  1 +
 MoltenVK/MoltenVK/Layers/MVKExtensions.mm     |  5 ++++
 MoltenVK/MoltenVK/Vulkan/vulkan.mm            | 12 ++++++++
 7 files changed, 50 insertions(+)

diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
index 8ce08f20f590..6cf8fd214f4f 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
@@ -259,6 +259,7 @@ public:
 
 	/** Populates the specified structure with the cooperative matrix properties of this device. */
 	VkResult getCooperativeMatrixProperties(uint32_t* pPropertyCount, VkCooperativeMatrixPropertiesKHR* pProperties); 
+	VkResult getCooperativeMatrixProperties2(const VkPhysicalDeviceCooperativeMatrixInfo2EXT* pInfo, uint32_t* pPropertyCount, VkCooperativeMatrixProperties2EXT* pProperties);
 
 #pragma mark Surfaces
 
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
index 262e6985c457..f3f0dd5890ff 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
@@ -577,6 +577,15 @@ void MVKPhysicalDevice::getFeatures(VkPhysicalDeviceFeatures2* features) {
 				coopMatFeatures->cooperativeMatrix = _metalFeatures.cooperativeMatrix;
 				break;
 			}
+			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COOPERATIVE_MATRIX_MAINTENANCE_1_FEATURES_EXT: {
+				auto* features = (VkPhysicalDeviceCooperativeMatrixMaintenance1FeaturesEXT*)next;
+				features->cooperativeMatrixProperties2 = _metalFeatures.cooperativeMatrix;
+				features->cooperativeMatrixReductions = _metalFeatures.cooperativeMatrix;
+				features->cooperativeMatrixPerElementOperations = _metalFeatures.cooperativeMatrix;
+				features->cooperativeMatrixConversions = VK_FALSE;
+				features->cooperativeMatrixGetCoordinate = VK_FALSE;
+				break;
+			}
 			case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_BARYCENTRIC_FEATURES_KHR: {
 				auto* barycentricFeatures = (VkPhysicalDeviceFragmentShaderBarycentricFeaturesKHR*)next;
 				barycentricFeatures->fragmentShaderBarycentric = true;
@@ -1958,6 +1967,26 @@ VkResult MVKPhysicalDevice::getCooperativeMatrixProperties(uint32_t* pPropertyCo
 }
 
 
+VkResult MVKPhysicalDevice::getCooperativeMatrixProperties2(const VkPhysicalDeviceCooperativeMatrixInfo2EXT* pInfo,
+														  uint32_t* pPropertyCount,
+														  VkCooperativeMatrixProperties2EXT* pProperties) {
+	uint32_t count = _metalFeatures.cooperativeMatrix && pInfo->scope == VK_SCOPE_SUBGROUP_KHR &&
+		(!pInfo->subgroupSize || pInfo->subgroupSize == 32) && !pInfo->flags ? 1 : 0;
+	if (!pProperties) {
+		*pPropertyCount = count;
+		return VK_SUCCESS;
+	}
+	uint32_t written = min(*pPropertyCount, count);
+	if (written) {
+		auto& properties = pProperties[0];
+		properties.MGranularity = properties.NGranularity = properties.KGranularity = 8;
+		properties.AType = properties.BType = properties.CType = properties.ResultType = VK_COMPONENT_TYPE_FLOAT32_KHR;
+	}
+	VkResult result = *pPropertyCount < count ? VK_INCOMPLETE : VK_SUCCESS;
+	*pPropertyCount = written;
+	return result;
+}
+
 #pragma mark Surfaces
 
 VkResult MVKPhysicalDevice::getSurfaceSupport(uint32_t queueFamilyIndex,
