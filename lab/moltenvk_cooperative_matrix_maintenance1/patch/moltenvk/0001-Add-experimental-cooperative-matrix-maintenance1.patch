diff --git a/MoltenVK/MoltenVK/Layers/MVKExtensions.mm b/MoltenVK/MoltenVK/Layers/MVKExtensions.mm
index 273a58a5f985..2907568a775f 100644
--- a/MoltenVK/MoltenVK/Layers/MVKExtensions.mm
+++ b/MoltenVK/MoltenVK/Layers/MVKExtensions.mm
@@ -20,6 +20,7 @@
 #include "MVKFoundation.h"
 #include "MVKOSExtensions.h"
 #include "mvk_deprecated_api.h"
+#include <cstdlib>
 #include <vulkan/vulkan_ios.h>
 #include <vulkan/vulkan_macos.h>
 
@@ -45,6 +46,10 @@ static VkExtensionProperties kVkExtProps_ ##EXT = mvkMakeExtProps(VK_ ##EXT ##_E
 
 // Returns whether the specified properties are valid for this platform
 static bool mvkIsSupportedOnPlatform(VkExtensionProperties* pProperties) {
+	if (pProperties == &kVkExtProps_EXT_COOPERATIVE_MATRIX_MAINTENANCE_1) {
+		const char* experimental = std::getenv("VULKANLAB_EXPERIMENTAL_CMM1");
+		if (!experimental || strcmp(experimental, "1") != 0) { return false; }
+	}
 #define MVK_EXTENSION_MIN_OS(EXT, MAC, IOS, XROS) \
 	if (pProperties == &kVkExtProps_##EXT) { return mvkOSVersionIsAtLeast(MAC, IOS, XROS); }
 
diff --git a/MoltenVK/MoltenVK/Vulkan/vulkan.mm b/MoltenVK/MoltenVK/Vulkan/vulkan.mm
index 6037f9dfd700..1f45af73ce1a 100644
--- a/MoltenVK/MoltenVK/Vulkan/vulkan.mm
+++ b/MoltenVK/MoltenVK/Vulkan/vulkan.mm
@@ -4387,6 +4387,18 @@ MVK_PUBLIC_VULKAN_SYMBOL VkResult vkGetPhysicalDeviceCooperativeMatrixProperties
 
 
 #pragma mark -
+MVK_PUBLIC_VULKAN_SYMBOL VkResult vkGetPhysicalDeviceCooperativeMatrixProperties2EXT(
+	VkPhysicalDevice physicalDevice,
+	const VkPhysicalDeviceCooperativeMatrixInfo2EXT* pCooperativeMatrixInfo,
+	uint32_t* pPropertyCount,
+	VkCooperativeMatrixProperties2EXT* pProperties) {
+	MVKTraceVulkanCallStart();
+	auto* device = MVKPhysicalDevice::getMVKPhysicalDevice(physicalDevice);
+	VkResult result = device->getCooperativeMatrixProperties2(pCooperativeMatrixInfo, pPropertyCount, pProperties);
+	MVKTraceVulkanCallEnd();
+	return result;
+}
+
 #pragma mark VK_EXT_private_data extension
 
 MVK_PUBLIC_VULKAN_CORE_ALIAS(vkCreatePrivateDataSlot, EXT);
