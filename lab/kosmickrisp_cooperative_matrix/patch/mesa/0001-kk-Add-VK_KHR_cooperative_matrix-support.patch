       P_IND(ctx, "t%d = ", instr->def.index);
    }
    switch (instr->intrinsic) {
+   case nir_intrinsic_simdgroup_matrix_muladd_kk:
+      P(ctx, "kk_matrix_muladd(");
+      for (unsigned source = 0; source < 3; ++source) {
+         if (source)
+            P(ctx, ", ");
+         src_to_msl(ctx, &instr->src[source]);
+      }
+      P(ctx, ");\n");
+      break;
    case nir_intrinsic_decl_reg: {
       const char *reg_type = msl_uint_type(nir_intrinsic_bit_size(instr),
                                            nir_intrinsic_num_components(instr));
@@ -2226,6 +2235,7 @@ msl_preprocess_nir(struct nir_shader *nir)
    NIR_PASS(_, nir, nir_lower_io_vars_to_temporaries,
             nir_shader_get_entrypoint(nir), nir_var_shader_out);
    NIR_PASS(_, nir, nir_lower_global_vars_to_local);
+   NIR_PASS(_, nir, msl_nir_lower_cooperative_matrix);
    NIR_PASS(_, nir, nir_split_var_copies);
    NIR_PASS(_, nir, nir_split_struct_vars, nir_var_function_temp);
    NIR_PASS(_, nir, nir_split_array_vars, nir_var_function_temp);
@@ -2508,8 +2518,28 @@ nir_to_msl(nir_shader *shader, struct nir_to_msl_options *options)
        shader->info.stage == MESA_SHADER_TESS_CTRL)
       P(&ctx, "#include <metal_compute>\n");
    P(&ctx, "#include <metal_stdlib>\n");
+   P(&ctx, "#include <metal_simdgroup_matrix>\n");
    P(&ctx, "using namespace metal;\n");
 
+   if (shader->info.stage == MESA_SHADER_COMPUTE) {
+      P(&ctx,
+        "template<typename Input, typename Accumulator>\n"
+            "vec<Accumulator, 2> kk_matrix_muladd(vec<Input, 2> input_a, "
+            "vec<Input, 2> input_b, vec<Accumulator, 2> accumulator) {\n"
+            "   simdgroup_matrix<Input, 8, 8> matrix_a, matrix_b;\n"
+            "   simdgroup_matrix<Accumulator, 8, 8> matrix_c, result;\n"
+            "   matrix_a.thread_elements()[0] = input_a.x; "
+            "matrix_a.thread_elements()[1] = input_a.y;\n"
+            "   matrix_b.thread_elements()[0] = input_b.x; "
+            "matrix_b.thread_elements()[1] = input_b.y;\n"
+            "   matrix_c.thread_elements()[0] = accumulator.x; "
+            "matrix_c.thread_elements()[1] = accumulator.y;\n"
+            "   simdgroup_multiply_accumulate(result, matrix_a, matrix_b, matrix_c);\n"
+        "   return vec<Accumulator, 2>(result.thread_elements()[0], "
+        "result.thread_elements()[1]);\n"
+        "}\n");
+   }
+
    msl_emit_constant_data(&ctx, shader);
 
    msl_emit_io_blocks(&ctx, shader);
