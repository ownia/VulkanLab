new file mode 100644
index 000000000000..c257d8879538
--- /dev/null
+++ b/src/kosmickrisp/compiler/msl_nir_lower_cooperative_matrix.c
@@ -0,0 +1,211 @@
+#include "nir_to_msl.h"
+#include "nir_builder.h"
+
+static const struct glsl_type *
+lower_matrix_type(const struct glsl_type *type)
+{
+   if (glsl_type_is_cmat(type)) {
+      const struct glsl_cmat_description *desc = glsl_get_cmat_description(type);
+      assert(desc->rows == 8 && desc->cols == 8);
+      assert(desc->element_type == GLSL_TYPE_FLOAT16 ||
+             desc->element_type == GLSL_TYPE_FLOAT);
+      return glsl_vector_type(desc->element_type, 2);
+   }
+
+   if (glsl_type_is_array(type)) {
+      const struct glsl_type *element = glsl_get_array_element(type);
+      const struct glsl_type *lowered = lower_matrix_type(element);
+      if (lowered != element)
+         return glsl_array_type(lowered, glsl_get_length(type),
+                                glsl_get_explicit_stride(type));
+   }
+
+   return type;
+}
+
+static struct glsl_cmat_description
+matrix_description(nir_src source)
+{
+   return *glsl_get_cmat_description(nir_src_as_deref(source)->type);
+}
+
+static nir_def *
+load_matrix(nir_builder *builder, nir_src source)
+{
+   struct glsl_cmat_description desc = matrix_description(source);
+   return nir_build_load_deref(builder, 2,
+                              glsl_base_type_bit_size(desc.element_type),
+                              source.ssa, 0);
+}
+
+static void
+matrix_coordinates(nir_builder *builder, nir_def **row, nir_def **column)
+{
+   nir_def *lane = nir_load_subgroup_invocation(builder);
+   *row = nir_ior(builder,
+                  nir_iand_imm(builder, nir_ushr_imm(builder, lane, 1), 3),
+                  nir_iand_imm(builder, nir_ushr_imm(builder, lane, 2), 4));
+   *column = nir_ior(builder,
+                     nir_ishl_imm(builder, nir_iand_imm(builder, lane, 1), 1),
+                     nir_iand_imm(builder, nir_ushr_imm(builder, lane, 1), 4));
+}
+
+static nir_def *
+transpose_matrix(nir_builder *builder, nir_def *matrix)
+{
+   nir_def *row, *column;
+   matrix_coordinates(builder, &row, &column);
+   nir_def *elements[2];
+   for (unsigned element = 0; element < 2; ++element) {
+      nir_def *source_row = nir_iadd_imm(builder, column, element);
+      nir_def *lane = nir_ior(builder,
+         nir_ishl_imm(builder, nir_iand_imm(builder, source_row, 3), 1),
+         nir_ishl_imm(builder, nir_iand_imm(builder, source_row, 4), 2));
+      lane = nir_ior(builder, lane,
+         nir_ior(builder,
+            nir_ushr_imm(builder, nir_iand_imm(builder, row, 2), 1),
+            nir_ishl_imm(builder, nir_iand_imm(builder, row, 4), 1)));
+      nir_def *first = nir_read_invocation(builder,
+                                          nir_channel(builder, matrix, 0), lane);
+      nir_def *second = nir_read_invocation(builder,
+                                           nir_channel(builder, matrix, 1), lane);
+      elements[element] = nir_bcsel(builder,
+         nir_ine_imm(builder, nir_iand_imm(builder, row, 1), 0), second, first);
+   }
+   return nir_vec(builder, elements, 2);
+}
+
+static void
+lower_matrix_memory(nir_builder *builder, nir_intrinsic_instr *intrinsic)
+{
+   bool load = intrinsic->intrinsic == nir_intrinsic_cmat_load;
+   struct glsl_cmat_description desc = matrix_description(intrinsic->src[!load]);
+   nir_deref_instr *pointer = nir_src_as_deref(intrinsic->src[load]);
+   unsigned pointer_stride = glsl_get_bit_size(pointer->type) / 8 *
+                             glsl_get_vector_elements(pointer->type);
+   pointer = nir_build_deref_cast(builder, &pointer->def, pointer->modes,
+                                  pointer->type, pointer_stride);
+   nir_def *row, *column;
+   matrix_coordinates(builder, &row, &column);
+   nir_def *values[2];
+   nir_def *matrix = load ? NULL : load_matrix(builder, intrinsic->src[1]);
+   for (unsigned element = 0; element < 2; ++element) {
+      nir_def *major = row;
+      nir_def *minor = nir_iadd_imm(builder, column, element);
+      if (nir_intrinsic_matrix_layout(intrinsic) == GLSL_MATRIX_LAYOUT_COLUMN_MAJOR)
+         SWAP(major, minor);
+      major = nir_imul(builder, major, intrinsic->src[2].ssa);
+      nir_deref_instr *address = nir_build_deref_ptr_as_array(builder, pointer,
+         nir_u2uN(builder, major, pointer->def.bit_size));
+      address = nir_build_deref_cast(builder, &address->def, pointer->modes,
+         glsl_scalar_type(desc.element_type),
+         glsl_base_type_bit_size(desc.element_type) / 8);
+      address = nir_build_deref_ptr_as_array(builder, address,
+         nir_u2uN(builder, minor, address->def.bit_size));
+      if (load)
+         values[element] = nir_load_deref(builder, address);
+      else
+         nir_store_deref(builder, address, nir_channel(builder, matrix, element), 1);
+   }
+   if (load)
+      nir_store_deref(builder, nir_src_as_deref(intrinsic->src[0]),
+                      nir_vec(builder, values, 2), 3);
+}
+
+static bool
+lower_matrix_intrinsic(nir_builder *builder, nir_intrinsic_instr *intrinsic,
+                       void *data)
+{
+   builder->cursor = nir_before_instr(&intrinsic->instr);
+   nir_def *value;
+   switch (intrinsic->intrinsic) {
+   case nir_intrinsic_cmat_length:
+      nir_def_replace(&intrinsic->def, nir_imm_int(builder, 2));
+      return true;
+   case nir_intrinsic_cmat_construct:
+      value = nir_replicate(builder, intrinsic->src[1].ssa, 2);
+      break;
+   case nir_intrinsic_cmat_load:
+   case nir_intrinsic_cmat_store:
+      lower_matrix_memory(builder, intrinsic);
+      nir_instr_remove(&intrinsic->instr);
+      return true;
+   case nir_intrinsic_cmat_muladd:
+      assert(!nir_intrinsic_saturate(intrinsic));
+      value = nir_simdgroup_matrix_muladd_kk(builder,
+         glsl_base_type_bit_size(matrix_description(intrinsic->src[0]).element_type),
+         load_matrix(builder, intrinsic->src[1]),
+         load_matrix(builder, intrinsic->src[2]),
+         load_matrix(builder, intrinsic->src[3]));
+      break;
+   case nir_intrinsic_cmat_copy:
+   case nir_intrinsic_cmat_bitcast:
+      value = load_matrix(builder, intrinsic->src[1]);
+      break;
+   case nir_intrinsic_cmat_convert:
+   case nir_intrinsic_cmat_transpose: {
+      builder->fp_math_ctrl = nir_intrinsic_fp_math_ctrl(intrinsic);
+      value = load_matrix(builder, intrinsic->src[1]);
+      if (intrinsic->intrinsic == nir_intrinsic_cmat_transpose)
+         value = transpose_matrix(builder, value);
+      unsigned bits = glsl_base_type_bit_size(
+         matrix_description(intrinsic->src[0]).element_type);
+      value = nir_f2fN(builder, value, bits);
+      break;
+   }
+   case nir_intrinsic_cmat_unary_op:
+      builder->fp_math_ctrl = nir_intrinsic_fp_math_ctrl(intrinsic);
+      value = nir_build_alu1(builder, nir_intrinsic_alu_op(intrinsic),
+                            load_matrix(builder, intrinsic->src[1]));
+      break;
+   case nir_intrinsic_cmat_binary_op:
+   case nir_intrinsic_cmat_scalar_op:
+      builder->fp_math_ctrl = nir_intrinsic_fp_math_ctrl(intrinsic);
+      value = nir_build_alu2(builder, nir_intrinsic_alu_op(intrinsic),
+         load_matrix(builder, intrinsic->src[1]),
+         intrinsic->intrinsic == nir_intrinsic_cmat_scalar_op ?
+            intrinsic->src[2].ssa : load_matrix(builder, intrinsic->src[2]));
+      break;
+   case nir_intrinsic_cmat_extract:
+      value = nir_vector_extract(builder, load_matrix(builder, intrinsic->src[0]),
+                                  intrinsic->src[1].ssa);
+      nir_def_replace(&intrinsic->def, value);
+      return true;
+   case nir_intrinsic_cmat_insert:
+      value = nir_vector_insert(builder, load_matrix(builder, intrinsic->src[2]),
+                                 intrinsic->src[1].ssa, intrinsic->src[3].ssa);
+      break;
+   default:
+      return false;
+   }
+
+   nir_store_deref(builder, nir_src_as_deref(intrinsic->src[0]), value, 3);
+   nir_instr_remove(&intrinsic->instr);
+   builder->fp_math_ctrl = nir_fp_fast_math;
+   return true;
+}
+
+bool
+msl_nir_lower_cooperative_matrix(nir_shader *shader)
+{
+   bool progress = nir_shader_intrinsics_pass(shader, lower_matrix_intrinsic,
+      nir_metadata_none, NULL);
+   if (!progress)
+      return false;
+
+   nir_foreach_variable_with_modes(variable, shader, nir_var_shader_temp)
+      variable->type = lower_matrix_type(variable->type);
+   nir_foreach_function_impl(implementation, shader) {
+      nir_foreach_function_temp_variable(variable, implementation)
+         variable->type = lower_matrix_type(variable->type);
+      nir_foreach_block(block, implementation) {
+         nir_foreach_instr(instruction, block) {
+            if (instruction->type == nir_instr_type_deref) {
+               nir_deref_instr *deref = nir_instr_as_deref(instruction);
+               deref->type = lower_matrix_type(deref->type);
+            }
+         }
+      }
+   }
+   return true;
+}
