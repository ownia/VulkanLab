+static nir_def *
+matrix_lane(nir_builder *builder, nir_def *row, nir_def *column);
+
+static nir_def *
+matrix_element(nir_builder *builder, nir_def *matrix,
+               nir_def *row, nir_def *column)
+{
+   nir_def *lane = matrix_lane(builder, row, column);
+   nir_def *first = nir_shuffle(builder, nir_channel(builder, matrix, 0), lane);
+   nir_def *second = nir_shuffle(builder, nir_channel(builder, matrix, 1), lane);
+   return nir_bcsel(builder,
+      nir_ine_imm(builder, nir_iand_imm(builder, column, 1), 0), second, first);
+}
+
+static nir_def *
+integer_matrix_muladd(nir_builder *builder, nir_intrinsic_instr *intrinsic)
+{
+   nir_cmat_signed signed_mask = nir_intrinsic_cmat_signed_mask(intrinsic);
+   nir_def *left = load_matrix(builder, intrinsic->src[1]);
+   nir_def *right = load_matrix(builder, intrinsic->src[2]);
+   left = signed_mask & NIR_CMAT_A_SIGNED ? nir_i2iN(builder, left, 32) :
+                                          nir_u2uN(builder, left, 32);
+   right = signed_mask & NIR_CMAT_B_SIGNED ? nir_i2iN(builder, right, 32) :
+                                           nir_u2uN(builder, right, 32);
+   nir_def *accumulator = load_matrix(builder, intrinsic->src[3]);
+   nir_def *values[2] = {
+      nir_channel(builder, accumulator, 0), nir_channel(builder, accumulator, 1),
+   };
+   nir_def *row, *column;
+   matrix_coordinates(builder, &row, &column);
+   for (unsigned inner = 0; inner < 8; ++inner) {
+      nir_def *index = nir_imm_int(builder, inner);
+      nir_def *left_element = matrix_element(builder, left, row, index);
+      for (unsigned element = 0; element < 2; ++element) {
+         nir_def *right_element = matrix_element(builder, right, index,
+            nir_iadd_imm(builder, column, element));
+         values[element] = nir_iadd(builder, values[element],
+            nir_imul(builder, left_element, right_element));
+      }
+   }
+   return nir_vec(builder, values, 2);
+}
+
 static nir_def *
