    return true;
 }
 
+static nir_def *
+reduce_pair(nir_builder *builder, nir_function *function,
+            nir_def *left, nir_def *right)
+{
+   nir_variable *result = nir_local_variable_create(builder->impl,
+      glsl_get_bare_type(function->params[0].type), "matrix_reduce");
+   nir_deref_instr *deref = nir_build_deref_var(builder, result);
+   nir_call(builder, function, &deref->def, left, right);
+   return nir_load_deref(builder, deref);
+}
+
+static nir_def *
+shuffle_xor(nir_builder *builder, nir_def *value, unsigned mask)
+{
+   nir_def *lane = nir_ixor(builder,
+      nir_load_subgroup_invocation(builder), nir_imm_int(builder, mask));
+   return nir_shuffle(builder, value, lane);
+}
+
+static nir_def *
+matrix_lane(nir_builder *builder, nir_def *row, nir_def *column)
+{
+   return nir_ior(builder,
+      nir_ior(builder,
+         nir_ishl_imm(builder, nir_iand_imm(builder, row, 3), 1),
+         nir_ishl_imm(builder, nir_iand_imm(builder, row, 4), 2)),
+      nir_ior(builder,
+         nir_ushr_imm(builder, nir_iand_imm(builder, column, 2), 1),
+         nir_ishl_imm(builder, nir_iand_imm(builder, column, 4), 1)));
+}
+
+static nir_def *
+lower_matrix_reduce(nir_builder *builder, nir_cmat_call_instr *call)
+{
+   nir_def *source = load_matrix(builder, call->params[1]);
+   nir_def *values[2] = {
+      nir_channel(builder, source, 0), nir_channel(builder, source, 1),
+   };
+   nir_cmat_reduce flags = nir_cmat_call_reduce_flags(call);
+   if (call->op == nir_cmat_call_op_reduce_finish) {
+      nir_def *other = load_matrix(builder, call->params[2]);
+      for (unsigned element = 0; element < 2; ++element)
+         values[element] = reduce_pair(builder, call->callee, values[element],
+                                       nir_channel(builder, other, element));
+      return nir_vec(builder, values, 2);
+   }
+
+   if (flags & NIR_CMAT_REDUCE_ROW) {
+      nir_def *value = reduce_pair(builder, call->callee, values[0], values[1]);
+      for (unsigned mask = 1; mask <= 8; mask *= 8)
+         value = reduce_pair(builder, call->callee, value,
+                             shuffle_xor(builder, value, mask));
+      values[0] = values[1] = value;
+   }
+   if (flags & NIR_CMAT_REDUCE_COLUMN) {
+      for (unsigned element = 0; element < 2; ++element) {
+         for (unsigned mask = 2; mask <= 16; mask *= 2) {
+            if (mask == 8)
+               continue;
+            values[element] = reduce_pair(builder, call->callee, values[element],
+               shuffle_xor(builder, values[element], mask));
+         }
+      }
+   }
+   return nir_vec(builder, values, 2);
+}
+
+static nir_def *
+lower_matrix_reduce_2x2(nir_builder *builder, nir_cmat_call_instr *call)
+{
+   nir_def *pairs[4];
+   for (unsigned tile = 0; tile < 4; ++tile) {
+      nir_def *source = load_matrix(builder, call->params[tile + 1]);
+      pairs[tile] = reduce_pair(builder, call->callee,
+         nir_channel(builder, source, 0), nir_channel(builder, source, 1));
+   }
+   nir_def *row, *column;
+   matrix_coordinates(builder, &row, &column);
+   nir_def *values[2];
+   for (unsigned element = 0; element < 2; ++element) {
+      nir_def *target_column = nir_iadd_imm(builder, column, element);
+      nir_def *lane = matrix_lane(builder,
+         nir_iand_imm(builder, nir_ishl_imm(builder, row, 1), 7),
+         nir_iand_imm(builder, nir_ishl_imm(builder, target_column, 1), 7));
+      nir_def *tiles[4];
+      for (unsigned tile = 0; tile < 4; ++tile) {
+         tiles[tile] = reduce_pair(builder, call->callee,
+            nir_shuffle(builder, pairs[tile], lane),
+            nir_shuffle(builder, pairs[tile],
+               nir_ixor(builder, lane, nir_imm_int(builder, 2))));
+      }
+      nir_def *right = nir_uge_imm(builder, target_column, 4);
+      values[element] = nir_bcsel(builder, nir_uge_imm(builder, row, 4),
+         nir_bcsel(builder, right, tiles[3], tiles[2]),
+         nir_bcsel(builder, right, tiles[1], tiles[0]));
+   }
+   return nir_vec(builder, values, 2);
+}
+
+static nir_def *
+lower_matrix_per_element(nir_builder *builder, nir_cmat_call_instr *call)
+{
+   nir_def *source = load_matrix(builder, call->params[3]);
+   nir_variable *result = nir_local_variable_create(builder->impl,
+      glsl_get_bare_type(call->callee->params[0].type), "matrix_element");
+   nir_deref_instr *deref = nir_build_deref_var(builder, result);
+   nir_def *row, *column;
+   matrix_coordinates(builder, &row, &column);
+   row = nir_iadd(builder, row, call->params[1].ssa);
+   column = nir_iadd(builder, column, call->params[2].ssa);
+   nir_def *values[2];
+   for (unsigned element = 0; element < 2; ++element) {
+      nir_call_instr *scalar_call = nir_call_instr_create(builder->shader, call->callee);
+      scalar_call->params[0] = nir_src_for_ssa(&deref->def);
+      scalar_call->params[1] = nir_src_for_ssa(row);
+      scalar_call->params[2] = nir_src_for_ssa(nir_iadd_imm(builder, column, element));
+      scalar_call->params[3] = nir_src_for_ssa(nir_channel(builder, source, element));
+      for (unsigned parameter = 4; parameter < call->num_params; ++parameter) {
+         nir_deref_instr *argument = nir_src_as_deref(call->params[parameter]);
+         nir_def *value = call->params[parameter].ssa;
+         if (argument && glsl_type_is_cmat(argument->type))
+            value = nir_channel(builder,
+               load_matrix(builder, call->params[parameter]), element);
+         scalar_call->params[parameter] = nir_src_for_ssa(value);
+      }
+      nir_builder_instr_insert(builder, &scalar_call->instr);
+      values[element] = nir_load_deref(builder, deref);
+   }
+   return nir_vec(builder, values, 2);
+}
+
+static bool
+lower_matrix_instruction(nir_builder *builder, nir_instr *instruction, void *data)
+{
+   if (instruction->type == nir_instr_type_intrinsic)
+      return lower_matrix_intrinsic(builder, nir_instr_as_intrinsic(instruction), data);
+   if (instruction->type != nir_instr_type_cmat_call)
+      return false;
+
+   builder->cursor = nir_before_instr(instruction);
+   nir_cmat_call_instr *call = nir_instr_as_cmat_call(instruction);
+   nir_def *value;
+   switch (call->op) {
+   case nir_cmat_call_op_reduce:
+   case nir_cmat_call_op_reduce_finish:
+      value = lower_matrix_reduce(builder, call);
+      break;
+   case nir_cmat_call_op_reduce_2x2:
+      value = lower_matrix_reduce_2x2(builder, call);
+      break;
+   case nir_cmat_call_op_per_element_op:
+      value = lower_matrix_per_element(builder, call);
+      break;
+   default:
+      UNREACHABLE("Unsupported cooperative matrix callback");
+   }
+   nir_store_deref(builder, nir_src_as_deref(call->params[0]), value, 3);
+   nir_instr_remove(instruction);
+   return true;
+}
+
 bool
 msl_nir_lower_cooperative_matrix(nir_shader *shader)
 {
-   bool progress = nir_shader_intrinsics_pass(shader, lower_matrix_intrinsic,
+   bool progress = nir_shader_instructions_pass(shader, lower_matrix_instruction,
       nir_metadata_none, NULL);
    if (!progress)
       return false;
