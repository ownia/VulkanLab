+MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::needsSPIRVSpecialization() const {
+	bool needsSpecialization = false;
+#if !MVK_EXCLUDE_SPIRV_TOOLS
+	spvtools::SpirvTools tools(SPV_ENV_VULKAN_1_3);
+	auto parseHeader = [](spv_endianness_t, const spv_parsed_header_t&) { return SPV_SUCCESS; };
+	tools.Parse(_spirv, parseHeader, [&](const spv_parsed_instruction_t& instruction) {
+		if (instruction.opcode == OpNop) { return SPV_SUCCESS; }
+		if (instruction.opcode != OpCapability) { return SPV_REQUESTED_TERMINATION; }
+		if (instruction.words[1] != CapabilityCooperativeMatrixKHR) { return SPV_SUCCESS; }
+		needsSpecialization = true;
+		return SPV_REQUESTED_TERMINATION;
+	});
+#endif
+	return needsSpecialization;
+}
+
 MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfiguration& shaderConfig,
 													SPIRVToMSLConversionResult& conversionResult,
 													bool shouldLogSPIRV,
@@ -279,13 +302,40 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfigur
 
 	if (shouldLogSPIRV) { logSPIRV(conversionResult.resultLog, "Converting"); }
 
-	CompilerMSL* pMSLCompiler = nullptr;
-	bool wasConverted = true;
+	vector<uint32_t> specializedSPIRV;
+	if (shaderConfig.shouldSpecializeSPIRV) {
+#if MVK_EXCLUDE_SPIRV_TOOLS
+		return logError(conversionResult.resultLog, "SPIR-V specialization requires SPIRV-Tools.");
+#else
+		spvtools::Optimizer optimizer(SPV_ENV_VULKAN_1_3);
+		optimizer.SetMessageConsumer([&](spv_message_level_t, const char*, const spv_position_t& position, const char* message) {
+			string diagnostic = "SPIR-V specialization at word " + to_string(position.index) + ": " + message;
+			logMsg(conversionResult.resultLog, diagnostic.c_str());
+		});
+		unordered_map<uint32_t, vector<uint32_t>> values(shaderConfig.specializationConstants.begin(),
+														   shaderConfig.specializationConstants.end());
+		optimizer.RegisterPass(spvtools::CreateFlattenDecorationPass());
+		optimizer.RegisterPass(spvtools::CreateSetSpecConstantDefaultValuePass(values));
+		optimizer.RegisterPass(spvtools::CreateFreezeSpecConstantValuePass());
+		optimizer.RegisterPass(spvtools::CreateFoldSpecConstantOpAndCompositePass());
+		spvtools::OptimizerOptions optimizerOptions;
+		optimizerOptions.set_run_validator(false);
+		if (!optimizer.Run(_spirv.data(), _spirv.size(), &specializedSPIRV, optimizerOptions)) {
+			return logError(conversionResult.resultLog, "Failed to specialize SPIR-V before MSL conversion.");
+		}
+		if (shouldLogSPIRV) {
+			conversionResult.resultLog += "Specialized SPIR-V:\n";
+			mvk::logSPIRV(specializedSPIRV, conversionResult.resultLog);
+		}
+#endif
+	}
+
+	unique_ptr<CompilerMSL> pMSLCompiler;
 
 #ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
 	try {
 #endif
-		pMSLCompiler = new CompilerMSL(_spirv);
+		pMSLCompiler = make_unique<CompilerMSL>(shaderConfig.shouldSpecializeSPIRV ? specializedSPIRV : _spirv);
 
 		if (shaderConfig.options.hasEntryPoint()) {
 			pMSLCompiler->set_entry_point(shaderConfig.options.entryPointName, shaderConfig.options.entryPointStage);
@@ -354,17 +404,17 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfigur
 	} catch (CompilerError& ex) {
 		string errMsg("SPIR-V to MSL conversion error: ");
 		errMsg += ex.what();
-		logError(conversionResult.resultLog, errMsg.data());
         if (shouldLogMSL && pMSLCompiler) {
 			auto partialMSL = pMSLCompiler->get_partial_source();
             logSource(conversionResult.resultLog, partialMSL, "MSL", "Partially converted");
         }
+		return logError(conversionResult.resultLog, errMsg.data());
 	}
 #endif
 
 	// Populate the shader conversion results with info from the compilation run,
 	// and mark which vertex attributes and resource bindings are used by the shader
-	populateEntryPoint(pMSLCompiler, shaderConfig.options, conversionResult.resultInfo.entryPoint);
+	populateEntryPoint(pMSLCompiler.get(), shaderConfig.options, conversionResult.resultInfo.entryPoint);
 	conversionResult.resultInfo.isRasterizationDisabled = pMSLCompiler && pMSLCompiler->get_is_rasterization_disabled();
 	conversionResult.resultInfo.isPositionInvariant = pMSLCompiler && pMSLCompiler->is_position_invariant();
 	conversionResult.resultInfo.needsSwizzleBuffer = pMSLCompiler && pMSLCompiler->needs_swizzle_buffer();
@@ -376,8 +426,8 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfigur
 	conversionResult.resultInfo.needsViewRangeBuffer = pMSLCompiler && pMSLCompiler->needs_view_mask_buffer();
 	conversionResult.resultInfo.needsDrawId = pMSLCompiler && pMSLCompiler->has_active_builtin(spv::BuiltInDrawIndex, spv::StorageClassInput);
 	conversionResult.resultInfo.needsDepthClipStateBuffer = pMSLCompiler && pMSLCompiler->needs_depth_clip_state_buffer();
-	conversionResult.resultInfo.usesPhysicalStorageBufferAddressesCapability = usesPhysicalStorageBufferAddressesCapability(pMSLCompiler);
-	populateSpecializationMacros(pMSLCompiler, conversionResult.resultInfo.specializationMacros);
+	conversionResult.resultInfo.usesPhysicalStorageBufferAddressesCapability = usesPhysicalStorageBufferAddressesCapability(pMSLCompiler.get());
+	populateSpecializationMacros(pMSLCompiler.get(), conversionResult.resultInfo.specializationMacros);
 
 	// When using Metal argument buffers, if the shader is provided with dynamic buffer offsets,
 	// then it needs a buffer to hold these dynamic offsets.
@@ -412,16 +462,16 @@ MVK_PUBLIC_SYMBOL bool SPIRVToMSLConverter::convert(SPIRVToMSLConversionConfigur
 		}
 	}
 
