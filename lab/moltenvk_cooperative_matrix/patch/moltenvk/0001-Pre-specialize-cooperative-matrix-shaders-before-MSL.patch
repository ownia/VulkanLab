 #pragma mark -
 #pragma mark MVKShaderModule
 
+bool MVKShaderModule::populateSPIRVSpecialization(SPIRVToMSLConversionConfiguration& shaderConfig,
+												 const VkSpecializationInfo* specializationInfo) {
+	shaderConfig.shouldSpecializeSPIRV = false;
+	shaderConfig.specializationConstants.clear();
+
+#ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
+	try {
+#endif
+		std::call_once(_specializationInfoOnce, [&] {
+			if (!_spvConverter.hasSPIRV()) { return; }
+			_shouldSpecializeSPIRV = _spvConverter.needsSPIRVSpecialization();
+			if (!_shouldSpecializeSPIRV) { return; }
+			SPIRV_CROSS_NAMESPACE::Compiler compiler(_spvConverter.getSPIRV());
+			for (const auto& specialization : compiler.get_specialization_constants()) {
+				const auto& constant = compiler.get_constant(specialization.id);
+				const auto& type = compiler.get_type(constant.constant_type);
+				bool isBoolean = type.basetype == SPIRV_CROSS_NAMESPACE::SPIRType::Boolean;
+				_specializationConstantTypes[specialization.constant_id] = {
+					isBoolean ? sizeof(VkBool32) : (type.width + 7) / 8, isBoolean
+				};
+			}
+		});
+#ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
+	} catch (const SPIRV_CROSS_NAMESPACE::CompilerError& error) {
+		reportError(VK_ERROR_INITIALIZATION_FAILED, "Could not inspect SPIR-V specialization constants: %s", error.what());
+		return false;
+	}
+#endif
+
+	shaderConfig.shouldSpecializeSPIRV = _shouldSpecializeSPIRV;
+	if (!_shouldSpecializeSPIRV || !specializationInfo) { return true; }
+	for (uint32_t entryIndex = 0; entryIndex < specializationInfo->mapEntryCount; ++entryIndex) {
+		const auto& entry = specializationInfo->pMapEntries[entryIndex];
+		auto constantType = _specializationConstantTypes.find(entry.constantID);
+		if (constantType == _specializationConstantTypes.end()) { continue; }
+		if (entry.size != constantType->second.size || !specializationInfo->pData ||
+			entry.offset > specializationInfo->dataSize || entry.size > specializationInfo->dataSize - entry.offset) {
+			reportError(VK_ERROR_INITIALIZATION_FAILED, "Invalid specialization data for SpecId %u.", entry.constantID);
+			return false;
+		}
+		auto& value = shaderConfig.specializationConstants[entry.constantID];
+		value.resize((entry.size + sizeof(uint32_t) - 1) / sizeof(uint32_t), 0);
+		memcpy(value.data(), static_cast<const uint8_t*>(specializationInfo->pData) + entry.offset, entry.size);
+		if (constantType->second.isBoolean) { value[0] = value[0] != 0; }
+	}
+	return true;
+}
