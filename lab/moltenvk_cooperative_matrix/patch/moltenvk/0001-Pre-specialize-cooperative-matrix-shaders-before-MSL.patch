 #ifndef SPIRV_CROSS_EXCEPTIONS_TO_ASSERTIONS
 		try {
 #endif
-			pGLSLCompiler = new CompilerGLSL(_spirv);
+			pGLSLCompiler = make_unique<CompilerGLSL>(_spirv);
 			auto options = pGLSLCompiler->get_common_options();
