/* ============================================================================
 * Kernel Fusion: Stable Row-Wise Softmax In A Cooperative Matrix
 *
 * Y = row_softmax(2 * X + column_bias), one subgroup per workgroup.
 *
 *     [Input X]                          [Column bias]
 *         |                                   |
 *         v                                   |
 *   [coopMatLoad]                             |
 *         |                                   |
 *         v                                   |
 *    [Scale by 2]                             |
 *         |                                   |
 *         +-----------------------------------+
 *         |
 *         v
 *   [Add column bias: coopMatPerElementEXT]
 *         |
 *         v
 *   [Row maximum: coopMatReduceEXT(Maximum)]
 *         |
 *         v
 *   [exp(value - row maximum): coopMatPerElementEXT]
 *         |
 *         v
 *   [Row sum: coopMatReduceEXT(Sum)]
 *         |
 *         v
 *   [Divide by row sum: coopMatPerElementEXT]
 *         |
 *         v
 *   [coopMatStore -> this workgroup's output Y tile]
 *
 * All intermediate values stay in cooperative matrices.
 * No shared-memory spill, extra dispatch, or intermediate storage buffer.
 *
 * Binding 0: one row-major FP32 X tile, shared by all workgroups.
 * Binding 1: one separate row-major FP32 Y tile per workgroup.
 * Binding 2: one FP32 bias value per logical column, shared by all workgroups.
 * Specialization IDs: 0 = local_size_x, 1 = rows, 2 = columns.
 * ============================================================================ */

#version 450
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_cooperative_matrix_maintenance1 : require

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const int rows = 8;
layout(constant_id = 2) const int columns = 8;

#define MATRIX coopmat<float, gl_ScopeSubgroup, rows, columns, gl_MatrixUseAccumulator>

layout(set = 0, binding = 0, std430) readonly coherent buffer Input {
    float values[];
} inputData;
layout(set = 0, binding = 1, std430) writeonly coherent buffer Output {
    float values[];
} outputData;
layout(set = 0, binding = 2, std430) readonly coherent buffer Bias {
    float values[];
} biasData;

float ApplyBias(const in uint row, const in uint column, const in float element) {
    return element + biasData.values[column];
}

float Maximum(const in float left, const in float right) {
    return max(left, right);
}

float Sum(const in float left, const in float right) {
    return left + right;
}

float Exponentiate(const in uint row, const in uint column, const in float element,
                   const in float rowMaximum) {
    return exp(element - rowMaximum);
}

float Normalize(const in uint row, const in uint column, const in float element,
                const in float rowSum) {
    return element / rowSum;
}

void main() {
    MATRIX matrix, rowMaximum, rowSum;
    coopMatLoad(matrix, inputData.values, 0u, uint(columns), gl_CooperativeMatrixLayoutRowMajor);
    matrix = matrix * 2.0;
    coopMatPerElementEXT(matrix, matrix, ApplyBias);
    coopMatReduceEXT(rowMaximum, matrix, gl_CooperativeMatrixReduceRowEXT, Maximum);
    coopMatPerElementEXT(matrix, matrix, Exponentiate, rowMaximum);
    coopMatReduceEXT(rowSum, matrix, gl_CooperativeMatrixReduceRowEXT, Sum);
    coopMatPerElementEXT(matrix, matrix, Normalize, rowSum);
    uint outputOffset = gl_WorkGroupID.x * uint(rows * columns);
    coopMatStore(matrix, outputData.values, outputOffset, uint(columns), gl_CooperativeMatrixLayoutRowMajor);
}